{
    "name": "hoppy-blocks",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start",
        "dev": "expo start -c",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "brand:build": "node scripts/build-brand-assets.mjs",
        "build:dev": "eas build --profile development",
        "build:preview": "eas build --profile preview",
        "build:prod": "eas build --profile production --platform all",
        "prepare": "husky",
        "bench:levels": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=src/engine/__bench__",
        "build:apk": "eas build --platform android --profile preview"
    },
    "dependencies": {
        "@expo-google-fonts/baloo-2": "^0.4.2",
        "@expo-google-fonts/rubik": "^0.4.2",
        "@expo/metro-runtime": "~58.0.17",
        "@react-native-async-storage/async-storage": "2.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "expo": "~58.0.25",
        "expo-asset": "~58.0.21",
        "expo-audio": "~58.0.12",
        "expo-constants": "~58.0.16",
        "expo-font": "~58.0.12",
        "expo-haptics": "~58.0.8",
        "expo-linear-gradient": "~58.0.4",
        "expo-linking": "~58.0.17",
        "expo-localization": "~58.0.5",
        "expo-router": "~58.0.31",
        "expo-splash-screen": "~58.0.14",
        "expo-status-bar": "~58.0.5",
        "expo-system-ui": "~58.0.7",
        "i18next": "^25.10.10",
        "nativewind": "^4.2.7",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-i18next": "^15.7.4",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-google-mobile-ads": "^17.2.0",
        "react-native-reanimated": "~4.7.1",
        "react-native-safe-area-context": "~5.11.1",
        "react-native-screens": "~4.30.1",
        "react-native-svg": "15.16.0",
        "react-native-web": "~0.21.4",
        "react-native-worklets": "0.13.0",
        "tailwind-merge": "^3.7.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@resvg/resvg-js": "^2.6.2",
        "@testing-library/react-native": "~13.3.3",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.19.43",
        "@types/react": "~19.3.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "babel-plugin-transform-remove-console": "^6.9.4",
        "eslint": "^9.39.5",
        "eslint-config-expo": "~58.0.4",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-expo": "~58.0.14",
        "lint-staged": "^16.4.0",
        "prettier": "3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "react-native-svg-transformer": "1.5.1",
        "react-test-renderer": "19.3.0",
