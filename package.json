{
    "name": "blockaroo",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start",
        "dev": "expo start -c",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "brand:build": "node scripts/build-brand-assets.mjs",
        "build:dev": "eas build --profile development",
        "build:preview": "eas build --profile preview",
        "build:prod": "eas build --profile production --platform all",
        "prepare": "husky",
        "bench:levels": "jest --testPathIgnorePatterns=/node_modules/ --testPathPattern=src/engine/__bench__",
        "brand:roo": "python3 scripts/brand/roo.py",
        "build:apk": "eas build --platform android --profile preview"
    },
    "dependencies": {
        "@expo-google-fonts/baloo-2": "^0.4.2",
        "@expo-google-fonts/rubik": "^0.4.2",
        "@expo/metro-runtime": "~57.0.17",
        "@react-native-async-storage/async-storage": "2.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "expo": "~57.0.30",
        "expo-asset": "~57.0.20",
        "expo-audio": "~57.0.5",
        "expo-constants": "~57.0.22",
        "expo-font": "~57.0.4",
        "expo-haptics": "~57.0.3",
        "expo-linear-gradient": "~57.0.2",
        "expo-linking": "~57.0.13",
        "expo-localization": "~57.0.2",
        "expo-router": "~57.0.28",
        "expo-splash-screen": "~57.0.10",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.4",
        "i18next": "^25.10.10",
        "nativewind": "^4.2.7",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-i18next": "^15.7.4",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-google-mobile-ads": "^17.2.0",
        "react-native-reanimated": "~4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.2",
        "react-native-svg": "15.15.4",
        "react-native-web": "~0.21.4",
        "react-native-worklets": "0.10.1",
        "tailwind-merge": "^3.7.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@resvg/resvg-js": "^2.6.2",
        "@testing-library/react-native": "~13.3.3",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.19.43",
        "@types/react": "~19.2.18",
        "babel-plugin-module-resolver": "^5.0.3",
        "babel-plugin-transform-remove-console": "^6.9.4",
        "eslint": "^9.39.5",
        "eslint-config-expo": "~57.0.2",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-expo": "~57.0.6",
        "lint-staged": "^16.4.0",
        "prettier": "3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "react-native-svg-transformer": "1.5.1",
        "react-test-renderer": "19.2.3",
        "tailwindcss": "3.4.3",
        "typescript": "~6.0.3"
    },
    "private": true,
    "packageManager": "pnpm@10.11.1"
}
