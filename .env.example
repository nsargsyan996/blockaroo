# AdMob app IDs (from https://apps.admob.com). Leave empty in development: Google's test IDs are used.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# AdMob ad unit IDs. Only read in production builds; every other build uses Google's test units.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
