{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "types": ["jest", "node"],
        "paths": {
            "@*": ["./src/*"]
        },
        "moduleSuffixes": [".native", ""]
    },
    "include": ["svg.d.ts", "**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
    "exclude": ["node_modules", "dist", "web-build", "coverage"]
}
